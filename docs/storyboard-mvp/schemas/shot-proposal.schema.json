{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://screenplay.local/schemas/storyboard/shot-proposal.schema.json",
  "type": "object", "additionalProperties": false, "required": ["id", "storyboardId", "targetShotId", "sourceRunId", "baseStoryboardRevision", "status", "candidateShot", "createdAt"],
