# Set to java for an integrated backend. Fixture mode is intentionally a development-only data source.
VITE_STORYBOARD_DATA_SOURCE=fixtures
# Leave blank when Vite proxies or serves alongside Java. Never place Gateway or model credentials here.
VITE_JAVA_API_BASE=
# Vite development proxy target, used when VITE_JAVA_API_BASE is blank.
JAVA_API_PROXY_TARGET=http://127.0.0.1:18084
# Match the Gateway mode. Mock results must be visibly labeled as workflow tests.
VITE_AGENT_MODE=mock
